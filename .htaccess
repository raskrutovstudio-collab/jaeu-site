Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Служебный обработчик авторизации не должен зациклиться.
  RewriteRule ^auth\.php$ - [L]

  # Не отдаём исходные/служебные файлы, если они случайно попадут в web-root.
  RewriteRule (^|/)(\.git|\.github|server|src|node_modules)(/|$) - [F,L,NC]
  RewriteRule (^|/)(package(-lock)?\.json|astro\.config\.mjs|tsconfig\.json)$ - [F,L,NC]

  # Реальные статические ассеты остаются обычными файлами.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !\.html?$ [NC]
  RewriteRule ^ - [L]

  # Любой пользовательский URL/HTML проходит через PHP-сессию.
  RewriteRule ^ auth.php [L,QSA]
</IfModule>
