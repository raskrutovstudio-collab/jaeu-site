---
import Icon from './Icon.astro';
import { finalCta, org, routes } from '../../data/home';

const subject = encodeURIComponent(finalCta.mailSubject);
---

<section class="h-final" aria-labelledby="final-title" data-reveal>
  <div class="h-shell h-final__inner">
    <h2 class="h-h2 h-final__title" id="final-title" data-i18n="finalCta.h2">{finalCta.h2}</h2>
    <hr class="h-rule" />
    <p class="h-final__text" data-i18n="finalCta.text">{finalCta.text}</p>
    <div class="h-final__actions">
      <a class="h-btn h-btn--primary" href={routes.membership}>
        <span data-i18n="ui.becomeMember">{finalCta.primary}</span>
        <Icon name="arrow" class="h-btn__arrow" />
      </a>
      <a class="h-link" href={`mailto:${org.email}?subject=${subject}`} data-i18n-attrs="href:finalCta.secondaryHref">
        <span data-i18n="finalCta.secondary">{finalCta.secondary}</span>
        <Icon name="arrow" class="h-link__arrow" />
      </a>
    </div>
  </div>
</section>
