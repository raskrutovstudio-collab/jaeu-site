---
export type IconName =
  | 'arrow'
  | 'community'
  | 'dialogue'
  | 'initiative'
  | 'expertise'
  | 'support'
  | 'partnership'
  | 'document'
  | 'burger'
  | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === 'arrow' && (
  <svg class={className} viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
    <path d="M0 6h22M17 1l5 5-5 5" />
  </svg>
)}

{name === 'community' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="16" cy="9" r="4" />
    <circle cx="6.5" cy="14" r="3.2" />
    <circle cx="25.5" cy="14" r="3.2" />
    <path d="M9 26v-1.6a7 7 0 0 1 14 0V26" />
    <path d="M1.5 25v-1a5.2 5.2 0 0 1 5-5.2M30.5 25v-1a5.2 5.2 0 0 0-5-5.2" />
  </svg>
)}

{name === 'dialogue' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 6.5h17v11h-9.5L5 22.5v-5H3z" />
    <path d="M20 11h9v10h-2.5v4.5L22 21h-4.5" />
  </svg>
)}

{name === 'initiative' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 3.5l3.2 6.7 7.3 1-5.3 5.2 1.3 7.3-6.5-3.5-6.5 3.5 1.3-7.3-5.3-5.2 7.3-1z" />
    <path d="M11 27.5h10" />
  </svg>
)}

{name === 'expertise' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 3.5h12l6 6v10.5" />
    <path d="M19 3.5V10h6" />
    <path d="M7 3.5v25h11" />
    <circle cx="23" cy="23" r="5" />
    <path d="M26.8 26.8L30.5 30.5" />
  </svg>
)}

{name === 'support' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 4l10 3.6v7.9c0 6.4-4.2 11.3-10 13.1-5.8-1.8-10-6.7-10-13.1V7.6z" />
    <path d="M11.5 15.5l3.4 3.4 6-6.4" />
  </svg>
)}

{name === 'partnership' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="16" cy="16" r="12.5" />
    <path d="M3.5 16h25" />
    <path d="M16 3.5c3.4 3.6 5.2 7.9 5.2 12.5S19.4 24.9 16 28.5c-3.4-3.6-5.2-7.9-5.2-12.5S12.6 7.1 16 3.5z" />
  </svg>
)}

{name === 'document' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 2.5h12l6 6v21H7z" />
    <path d="M19 2.5V9h6" />
    <path d="M11.5 17h9M11.5 22h9" />
  </svg>
)}

{name === 'burger' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <path d="M3 6h18M3 12h18M3 18h18" />
  </svg>
)}

{name === 'close' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <path d="M5 5l14 14M19 5L5 19" />
  </svg>
)}
