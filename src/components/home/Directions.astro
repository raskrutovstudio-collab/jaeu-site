---
import Icon from './Icon.astro';
import { directions } from '../../data/home';
import { withBase } from '../../data/site';
---

<section class="h-section h-section--stone" aria-labelledby="directions-title" data-reveal>
  <div class="h-shell">
    <div class="h-section__head h-section__head--center">
      <h2 class="h-h2" id="directions-title" data-i18n="directions.h2">{directions.h2}</h2>
      <hr class="h-rule" />
      <p class="h-text" data-i18n="directions.lead">{directions.lead}</p>
    </div>

    <div class="h-dirs">
      {directions.items.map((item, index) => (
        <article class="h-dirs__item">
          <Icon name={item.icon} class="h-dirs__icon" />
          <h3 class="h-h3" data-i18n={`directions.items.${index}.title`}>{item.title}</h3>
          <p class="h-dirs__text" data-i18n={`directions.items.${index}.text`}>{item.text}</p>
          <a class="h-link" href={item.href}>
            <span data-i18n="ui.readMore">Подробнее</span>
            <Icon name="arrow" class="h-link__arrow" />
          </a>
        </article>
      ))}

      <figure class="h-dirs__strip" data-reveal-media>
        <img
          src={withBase('/assets/jaeu/directions-review-1160.webp')}
          srcset={`${withBase('/assets/jaeu/directions-review-760.webp')} 760w, ${withBase('/assets/jaeu/directions-review-1160.webp')} 1160w`}
          sizes="(min-width: 1041px) 870px, 100vw"
          width="1160"
          height="326"
          alt={directions.reviewAlt}
          data-i18n-attrs="alt:directions.reviewAlt"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="h-dirs__band" data-reveal-media>
        <img
          src={withBase('/assets/jaeu/directions-craft-1160.webp')}
          srcset={`${withBase('/assets/jaeu/directions-craft-760.webp')} 760w, ${withBase('/assets/jaeu/directions-craft-1160.webp')} 1160w`}
          sizes="(min-width: 1240px) 1160px, 100vw"
          width="1160"
          height="338"
          alt={directions.craftAlt}
          data-i18n-attrs="alt:directions.craftAlt"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>
