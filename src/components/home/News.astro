---
import Icon from './Icon.astro';
import { news, routes } from '../../data/home';
import { withBase } from '../../data/site';

/*
  Обе компактные новости используют один медиаформат: квадрат в одинаковом
  контейнере. Разный масштаб оставлен только за крупной новостью сверху.
*/
const thumb = 400;
---

<section class="h-section h-section--ivory" aria-labelledby="news-title" data-reveal>
  <div class="h-shell">
    <div class="h-section__head">
      <h2 class="h-h2" id="news-title" data-i18n="news.h2">{news.h2}</h2>
      <a class="h-link" href={routes.news}>
        <span data-i18n="news.allLink">{news.allLink}</span>
        <Icon name="arrow" class="h-link__arrow" />
      </a>
    </div>

    <div class="h-news">
      <article>
        <a class="h-news__card" href={routes.news}>
          <span class="h-news__media h-news__media--lg" data-reveal-media>
            <img
              src={withBase('/assets/jaeu/news-discussion-1000.webp')}
              srcset={`${withBase('/assets/jaeu/news-discussion-660.webp')} 660w, ${withBase('/assets/jaeu/news-discussion-1000.webp')} 1000w`}
              sizes="(min-width: 1041px) 660px, 100vw"
              width="1000"
              height="563"
              alt={news.featured.imageAlt}
              data-i18n-attrs="alt:news.featured.imageAlt"
              loading="lazy"
              decoding="async"
            />
          </span>
          <time class="h-news__date" datetime={news.featured.date} data-i18n="news.featured.dateLabel">{news.featured.dateLabel}</time>
          <span class="h-news__title h-news__title--lg" data-i18n="news.featured.title">{news.featured.title}</span>
          <span class="h-news__text" data-i18n="news.featured.text">{news.featured.text}</span>
        </a>
      </article>

      <div class="h-news__side">
        {news.items.map((item, index) => (
          <article class="h-news__row">
            <a class="h-news__card h-news__row-link" href={routes.news}>
              <span class="h-news__media" data-reveal-media>
                <img
                  src={withBase(`/assets/jaeu/${item.image}-400.webp`)}
                  srcset={`${withBase(`/assets/jaeu/${item.image}-240.webp`)} 240w, ${withBase(`/assets/jaeu/${item.image}-400.webp`)} 400w`}
                  sizes="(min-width: 1041px) 168px, 116px"
                  width={thumb}
                  height={thumb}
                  alt={item.imageAlt}
                  data-i18n-attrs={`alt:news.items.${index}.imageAlt`}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span>
                <time class="h-news__date" datetime={item.date} data-i18n={`news.items.${index}.dateLabel`}>{item.dateLabel}</time>
                <span class="h-news__title" data-i18n={`news.items.${index}.title`}>{item.title}</span>
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
