---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { nav, org, routes } from '../../data/home';
import { withBase } from '../../data/site';

interface Props {
  /** Путь текущей страницы: нужен для активного пункта и якорей на главную. */
  currentPath?: string;
  /** На внутренних страницах клиентского перевода нет, поэтому переключатель скрыт. */
  withLangSwitch?: boolean;
}

const { currentPath = routes.home, withLangSwitch = true } = Astro.props;

const cta = 'Стать членом Ассоциации';
/* В строке шапки кнопка соседствует с восемью пунктами меню, поэтому короче. */
const ctaShort = 'Стать членом';

/* Ноутбучный десктоп 1200–1439 px: в строке остаются только эти разделы,
   остальные доступны через burger. */
const compactNav = new Set<string>([
  routes.about,
  routes.activities,
  routes.expertCouncil,
  routes.news
]);

/* Якорь ведёт на блок главной, поэтому вне главной ему нужен полный путь. */
const linkFor = (href: string) =>
  href.startsWith('#') && currentPath !== routes.home ? `${routes.home}${href}` : href;
const isCurrent = (href: string) => !href.startsWith('#') && href === currentPath;
---

<header class="h-header">
  <div class="h-shell h-shell--wide h-header__bar">
    <a
      class="h-logo"
      href={routes.home}
      aria-label={`${org.shortName} — на главную`}
      data-i18n-attrs="aria-label:ui.logoAria"
    >
      <img
        src={withBase('/assets/jaeu/logo-jaeu.webp')}
        width="190"
        height="60"
        alt="Ассоциация ювелиров Евразийского экономического союза"
        data-i18n-attrs="alt:ui.logoAlt"
        fetchpriority="high"
      />
    </a>

    <nav class="h-nav" data-i18n-attrs="aria-label:ui.navLabel" aria-label="Основная навигация">
      <ul class="h-nav__list">
        {nav.map((item) => (
          <li class:list={['h-nav__item', compactNav.has(item.href) && 'h-nav__item--key']}>
            <a
              class="h-nav__link"
              href={linkFor(item.href)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              data-i18n={item.i18n}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="h-header__aside">
      {withLangSwitch && <LangSwitch />}
      <a class="h-btn h-btn--primary h-header__cta" href={routes.membership}>
        <span data-i18n="ui.becomeMemberShort">{ctaShort}</span>
        <Icon name="arrow" class="h-btn__arrow" />
      </a>
    </div>

    <button
      class="h-burger"
      type="button"
      id="h-burger"
      aria-expanded="false"
      aria-controls="h-mobile-menu"
      aria-label="Открыть меню"
      data-label-open="Открыть меню"
      data-label-close="Закрыть меню"
      data-i18n-attrs="aria-label:ui.menuOpen;data-label-open:ui.menuOpen;data-label-close:ui.menuClose"
    >
      <Icon name="burger" class="h-burger__open" />
      <Icon name="close" class="h-burger__close" />
    </button>
  </div>

  <div class="h-mobile" id="h-mobile-menu">
    <div class="h-shell h-shell--wide h-mobile__inner">
      <nav aria-label="Мобильная навигация" data-i18n-attrs="aria-label:ui.navLabelMobile">
        <ul class="h-mobile__list">
          {nav.map((item) => (
            <li>
              <a
                class="h-mobile__link"
                href={linkFor(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                data-i18n={item.i18n}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="h-mobile__foot">
        {withLangSwitch && <LangSwitch />}
        <a class="h-btn h-btn--primary" href={routes.membership}>
          <span data-i18n="ui.becomeMember">{cta}</span>
          <Icon name="arrow" class="h-btn__arrow" />
        </a>
      </div>
    </div>
  </div>
</header>
