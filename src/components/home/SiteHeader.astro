---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { nav, org, routes } from '../../data/home';
import { withBase } from '../../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = routes.home } = Astro.props;
const cta = 'Стать членом Ассоциации';
const ctaShort = 'Стать членом';
const primaryNav = nav.filter((item) => item.href !== routes.knowledge && item.href !== routes.reports);
const isCurrent = (href: string) => href === currentPath;
---

<header class="h-header">
  <div class="h-shell h-shell--wide h-header__bar">
    <a
      class="h-logo"
      href={routes.home}
      aria-label={`${org.shortName} — на главную`}
      data-i18n-attrs="aria-label:ui.logoAria"
    >
      <img
        src={withBase('/assets/jaeu/logo-jaeu-200.webp')}
        srcset={`${withBase('/assets/jaeu/logo-jaeu-200.webp')} 200w, ${withBase('/assets/jaeu/logo-jaeu-400.webp')} 400w`}
        sizes="190px"
        width="190"
        height="60"
        alt="Ассоциация ювелиров Евразийского экономического союза"
        data-i18n-attrs="alt:ui.logoAlt"
        decoding="async"
      />
    </a>

    <nav class="h-nav" data-i18n-attrs="aria-label:ui.navLabel" aria-label="Основная навигация">
      <ul class="h-nav__list">
        {primaryNav.map((item) => (
          <li class:list={['h-nav__item', item.key && 'h-nav__item--key']}>
            <a class="h-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-i18n={item.i18n}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="h-header__aside">
      <LangSwitch />
      <a class="h-btn h-btn--primary h-header__cta" href={routes.membership}>
        <span data-i18n="ui.becomeMemberShort">{ctaShort}</span>
        <Icon name="arrow" class="h-btn__arrow" />
      </a>
    </div>

    <button class="h-burger" type="button" id="h-burger" aria-expanded="false" aria-controls="h-mobile-menu" aria-label="Открыть меню" data-label-open="Открыть меню" data-label-close="Закрыть меню" data-i18n-attrs="aria-label:ui.menuOpen;data-label-open:ui.menuOpen;data-label-close:ui.menuClose">
      <Icon name="burger" class="h-burger__open" />
      <Icon name="close" class="h-burger__close" />
    </button>
  </div>

  <div class="h-mobile" id="h-mobile-menu">
    <div class="h-shell h-shell--wide h-mobile__inner">
      <nav aria-label="Мобильная навигация" data-i18n-attrs="aria-label:ui.navLabelMobile">
        <ul class="h-mobile__list">
          {primaryNav.map((item) => (
            <li class:list={['h-mobile__item', item.key && 'h-mobile__item--key']}>
              <a class="h-mobile__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-i18n={item.i18n}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="h-mobile__foot">
        <LangSwitch />
        <a class="h-btn h-btn--primary h-mobile__cta" href={routes.membership}>
          <span data-i18n="ui.becomeMember">{cta}</span>
          <Icon name="arrow" class="h-btn__arrow" />
        </a>
      </div>
    </div>
  </div>
</header>
