---
import Icon from './Icon.astro';
import { hero, routes, trust } from '../../data/home';
import { withBase } from '../../data/site';
---

<section class="h-hero" aria-labelledby="hero-title">
  <div class="h-hero__grid">
    <div class="h-hero__content">
      <p class="h-eyebrow" data-i18n="hero.eyebrow">{hero.eyebrow}</p>
      <h1 class="h-h1 h-hero__h1" id="hero-title" data-i18n="hero.h1">{hero.h1}</h1>
      <p class="h-lead" data-i18n="hero.lead">{hero.lead}</p>
      <div class="h-hero__actions">
        <a class="h-btn h-btn--primary" href={routes.membership}>
          <span data-i18n="ui.becomeMember">{hero.primaryCta}</span>
          <Icon name="arrow" class="h-btn__arrow" />
        </a>
        <a class="h-link" href={routes.activities}>
          <span data-i18n="hero.secondaryCta">{hero.secondaryCta}</span>
          <Icon name="arrow" class="h-link__arrow" />
        </a>
      </div>
    </div>

    <figure class="h-hero__media">
      <img
        src={withBase('/assets/jaeu/hero-1600.webp')}
        srcset={`${withBase('/assets/jaeu/hero-760.webp')} 760w, ${withBase('/assets/jaeu/hero-1100.webp')} 1100w, ${withBase('/assets/jaeu/hero-1600.webp')} 1536w`}
        sizes="(min-width: 1041px) 50vw, 100vw"
        width="1536"
        height="1024"
        alt={hero.imageAlt}
        data-i18n-attrs="alt:hero.imageAlt"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <span class="h-hero__veil" aria-hidden="true"></span>
      <span class="h-hero__edge" aria-hidden="true"></span>
    </figure>
  </div>

  <div class="h-trust">
    <div class="h-shell">
      <ul class="h-trust__list">
        {trust.map((item, index) => (
          <li class="h-trust__item">
            <Icon name={item.icon} class="h-trust__icon" />
            <span class="h-trust__label" data-i18n={`trust.${index}`}>{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
