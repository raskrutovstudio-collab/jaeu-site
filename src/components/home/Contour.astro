---
import Icon from './Icon.astro';
import { contour, routes } from '../../data/home';
import { withBase } from '../../data/site';
---

<section class="h-section h-section--white" aria-labelledby="contour-title" data-reveal>
  <div class="h-shell h-split h-split--text-left">
    <div class="h-split__text">
      <p class="h-eyebrow" data-i18n="contour.eyebrow">Институциональное взаимодействие</p>
      <h2 class="h-h2" id="contour-title" data-i18n="contour.h2">{contour.h2}</h2>
      <hr class="h-rule" />
      <p class="h-text" data-i18n="contour.text">{contour.text}</p>
      <a class="h-link" href={routes.activities}>
        <span data-i18n="contour.link">{contour.link}</span>
        <Icon name="arrow" class="h-link__arrow" />
      </a>
    </div>

    <figure class="h-frame" data-reveal-media>
      <img
        src={withBase('/assets/jaeu/page-council-stone-1100.webp')}
        srcset={`${withBase('/assets/jaeu/page-council-stone-700.webp')} 700w, ${withBase('/assets/jaeu/page-council-stone-1100.webp')} 1100w`}
        sizes="(min-width: 1040px) 620px, 100vw"
        width="1100"
        height="825"
        alt={contour.imageAlt}
        data-i18n-attrs="alt:contour.imageAlt"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>

  <div class="h-shell">
    <p class="h-aside">
      <span class="h-aside__rule" aria-hidden="true"></span>
      <span data-i18n="contour.dialogue">{contour.dialogue}</span>
    </p>

    <figure class="h-contour__context" data-reveal-media>
      <img
        src={withBase('/assets/jaeu/contour-loupe-1160.webp')}
        srcset={`${withBase('/assets/jaeu/contour-loupe-760.webp')} 760w, ${withBase('/assets/jaeu/contour-loupe-1160.webp')} 1160w`}
        sizes="(min-width: 1240px) 1160px, 100vw"
        width="1160"
        height="261"
        alt={contour.contextAlt}
        data-i18n-attrs="alt:contour.contextAlt"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
