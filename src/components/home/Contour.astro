---
import Icon from './Icon.astro';
import { contour } from '../../data/home';

const full = '/assets/jaeu/contour-1600.webp';
---

<section class="h-section h-section--white" aria-labelledby="contour-title" data-reveal>
  <div class="h-shell h-split h-split--text-left">
    <div class="h-split__text">
      <p class="h-eyebrow">Институциональное взаимодействие</p>
      <h2 class="h-h2" id="contour-title">{contour.h2}</h2>
      <hr class="h-rule" />
      <p class="h-text">{contour.text}</p>
      <button
        class="h-link"
        type="button"
        data-lightbox-src={full}
        data-lightbox-alt={contour.imageAlt}
        data-lightbox-caption={contour.caption}
        data-lightbox-width="1600"
        data-lightbox-height="1097"
      >
        {contour.link}
        <Icon name="arrow" class="h-link__arrow" />
      </button>
    </div>

    <figure class="h-figure">
      <button
        class="h-figure__btn"
        type="button"
        data-lightbox-src={full}
        data-lightbox-alt={contour.imageAlt}
        data-lightbox-caption={contour.caption}
        data-lightbox-width="1600"
        data-lightbox-height="1097"
        aria-label="Открыть инфографику институционального контура в полном размере"
      >
        <img
          src={full}
          srcset="/assets/jaeu/contour-1000.webp 1000w, /assets/jaeu/contour-1600.webp 1600w"
          sizes="(min-width: 1040px) 640px, 100vw"
          width="1600"
          height="1097"
          alt={contour.imageAlt}
          loading="lazy"
          decoding="async"
        />
      </button>
      <figcaption class="h-figure__caption">{contour.caption}</figcaption>
    </figure>
  </div>

  <div class="h-shell">
    <figure class="h-contour__context" data-reveal-media>
      <img
        src="/assets/jaeu/contour-context-1160.webp"
        srcset="/assets/jaeu/contour-context-760.webp 760w, /assets/jaeu/contour-context-1160.webp 1160w"
        sizes="(min-width: 1240px) 1160px, 100vw"
        width="1160"
        height="326"
        alt={contour.contextAlt}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
