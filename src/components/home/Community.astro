---
import Icon from './Icon.astro';
import { community, routes } from '../../data/home';
import { withBase } from '../../data/site';
---

<section class="h-section h-section--white" aria-labelledby="community-title" data-reveal>
  <div class="h-shell">
    <div class="h-split h-split--media-left">
      <figure class="h-frame" data-reveal-media>
        <img
          src={withBase('/assets/jaeu/community-experts-820.webp')}
          srcset={`${withBase('/assets/jaeu/community-experts-600.webp')} 600w, ${withBase('/assets/jaeu/community-experts-820.webp')} 820w`}
          sizes="(min-width: 1040px) 640px, 100vw"
          width="820"
          height="656"
          alt={community.imageAlt}
          data-i18n-attrs="alt:community.imageAlt"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="h-split__text">
        <p class="h-eyebrow" data-i18n="community.eyebrow">{community.eyebrow}</p>
        <h2 class="h-h2" id="community-title" data-i18n="community.h2">{community.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-i18n="community.text">{community.text}</p>
        <a class="h-btn h-btn--outline" href={routes.membership}>
          <span data-i18n="community.cta">{community.cta}</span>
          <Icon name="arrow" class="h-btn__arrow" />
        </a>
      </div>
    </div>

    <div class="h-band h-band--text">
      <h3 class="h-h3" data-i18n="community.band.title">{community.band.title}</h3>
      <p class="h-text" data-i18n="community.band.text">{community.band.text}</p>
    </div>
  </div>
</section>
