---
import Icon from './Icon.astro';
import { documents, routes } from '../../data/home';
---

<section class="h-section h-section--white" aria-labelledby="documents-title" data-reveal>
  <div class="h-shell">
    <div class="h-docs__belt" aria-hidden="true">
      <img
        src="/assets/jaeu/documents-belt-1160.webp"
        srcset="/assets/jaeu/documents-belt-760.webp 760w, /assets/jaeu/documents-belt-1160.webp 1160w"
        sizes="(min-width: 1240px) 1160px, 100vw"
        width="1160"
        height="261"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="h-section__head">
      <h2 class="h-h2" id="documents-title">{documents.h2}</h2>
      <a class="h-link" href={routes.documents}>
        {documents.allLink}
        <Icon name="arrow" class="h-link__arrow" />
      </a>
    </div>

    <ul class="h-docs">
      {documents.items.map((title) => (
        <li class="h-docs__item">
          <a class="h-docs__link" href={routes.documents}>
            <Icon name="document" class="h-docs__icon" />
            <span class="h-docs__name">{title}</span>
            <span class="h-docs__hint">{documents.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
