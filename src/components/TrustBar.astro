---
interface Props {
  items: readonly string[] | string[];
}

const { items } = Astro.props;
---

<section class="trust-bar">
  <div class="container">
    <ul class="trust-bar__list">
      {items.map((item) => (
        <li class="trust-bar__item">
          <span class="trust-bar__mark" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
