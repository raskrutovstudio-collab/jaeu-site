---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './Hero.astro';
import TrustBar from './TrustBar.astro';
import SectionHeading from './SectionHeading.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import NewsCard from './NewsCard.astro';
import DocumentRow from './DocumentRow.astro';
import CtaBanner from './CtaBanner.astro';
import { homeCopy, ui } from '../data/copy';
import { activityItems, documentPlaceholders, newsPlaceholders, placeholderText } from '../data/placeholders';
import { homePath, routes, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const chrome = ui[locale];
const info = placeholderText(locale);
const news = newsPlaceholders(locale);
const documents = documentPlaceholders(locale);
---

<PageLayout locale={locale} title={copy.title} description={copy.description} path={homePath(locale)} withHreflang>
  <Hero
    title={copy.h1}
    lead={copy.lead}
    joinLabel={copy.join}
    activitiesLabel={copy.aboutActivities}
    imageLabel={chrome.placeholders.image}
  />

  <TrustBar items={copy.trust} />

  <section class="section container" id="about">
    <div class="about-split">
      <div class="about-split__meta">
        <h2>{copy.aboutTitle}</h2>
      </div>
      <div class="about-split__content">
        <p class="prose">{copy.aboutText}</p>
        <a class="text-link" href={routes.about}>{copy.aboutLink}</a>
        <ImagePlaceholder label={chrome.placeholders.image} variant="about" />
      </div>
    </div>
  </section>

  <section class="section container" id="activities">
    <SectionHeading title={copy.activitiesTitle} lead={copy.activitiesLead} />
    <div class="activities-grid">
      {activityItems.map((item) => (
        <article class:list={['activity-card', `activity-card--${item.span}`, `activity-card--${item.tone}`]}>
          <div>
            <h3>{item.title[locale]}</h3>
            <p>{info}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container">
    <CtaBanner
      variant="dark"
      title={copy.membershipTitle}
      text={copy.membershipText}
      ctaLabel={copy.membershipCta}
      href={routes.membership}
    />
  </section>

  <section class="section container" id="news">
    <SectionHeading title={copy.newsTitle} />
    <div class="news-grid">
      <NewsCard
        size="large"
        title={news[0].title}
        text={news[0].text}
        href={routes.news}
        imageLabel={chrome.placeholders.image}
      />
      <div class="news-grid__side">
        <NewsCard size="medium" title={news[1].title} text={news[1].text} href={routes.news} />
        <NewsCard size="small" title={news[2].title} text={news[2].text} href={routes.news} />
      </div>
    </div>
    <p style="margin-top: 24px;">
      <a class="text-link" href={routes.news}>{chrome.allNews}</a>
    </p>
  </section>

  <section class="section container" id="documents">
    <div class="about-split" style="align-items: start;">
      <div class="about-split__meta">
        <h2>{copy.documentsTitle}</h2>
        <p class="section-heading__lead" style="margin-top: 12px;">{copy.documentsLead}</p>
        <a class="text-link" href={routes.documents}>{chrome.allDocuments}</a>
      </div>
      <div class="document-list">
        {documents.map((doc) => (
          <DocumentRow title={doc.title} href={routes.documents} />
        ))}
      </div>
    </div>
  </section>

  <section class="section container">
    <CtaBanner
      variant="light"
      title={copy.ctaTitle}
      text={copy.ctaText}
      ctaLabel={copy.join}
      href={routes.membership}
    />
  </section>
</PageLayout>
