---
import { formCopy } from '../data/copy';
import type { Locale } from '../data/site';

interface Props {
  locale?: Locale;
  variant: 'membership' | 'contact';
  title: string;
}

const { locale = 'ru', variant, title } = Astro.props;
const copy = formCopy[locale];
const submitLabel = variant === 'membership' ? copy.submitMembership : copy.submitContact;
---

<section class="demo-form" aria-labelledby="form-heading">
  <h2 id="form-heading">{title}</h2>
  <p class="demo-form__notice">{copy.notice}</p>

  <div class="form-success" data-form-success>
    <p>{copy.notice}. {copy.success}</p>
  </div>

  <form data-demo-form novalidate>
    {variant === 'membership' && (
      <div class="form-field">
        <label for="organisation">{copy.organisation}</label>
        <input id="organisation" name="organisation" type="text" required autocomplete="organization" />
        <p class="error">{copy.required}</p>
      </div>
    )}
    <div class="form-field">
      <label for="name">{copy.name}</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
      <p class="error">{copy.required}</p>
    </div>
    <div class="form-field">
      <label for="email">{copy.email}</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
      <p class="error">{copy.emailInvalid}</p>
    </div>
    <div class="form-field">
      <label for="message">{copy.message}</label>
      <textarea id="message" name="message" required></textarea>
      <p class="error">{copy.required}</p>
    </div>
    <button class="button button--primary" type="submit">{submitLabel}</button>
  </form>
</section>
