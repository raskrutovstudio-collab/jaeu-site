---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../data/copy';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  withHreflang?: boolean;
  /** Передаётся в BaseLayout: см. описание там. */
  noindex?: boolean;
}

const { locale, title, description, path, withHreflang = false, noindex = false } = Astro.props;
const copy = ui[locale];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path={path}
  withHreflang={withHreflang}
  noindex={noindex}
>
  <a class="skip-link" href="#content">{copy.skip}</a>
  <Header locale={locale} currentPath={path} />
  <main id="content">
    <slot />
  </main>
  <Footer locale={locale} />
</BaseLayout>
