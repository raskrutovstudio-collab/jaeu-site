---
import '../styles/home.css';
import '../styles/visual-refine.css';
import '../styles/editorial-type.css';
import I18nRuntime from '../components/I18nRuntime.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { faq, meta, org } from '../data/home';
import { homeI18nPayload } from '../data/homeI18n';
import { canonicalUrl, productionOrigin, withBase } from '../data/site';

const site = new URL(productionOrigin);
const canonical = canonicalUrl('/');
const ogImage = new URL('/assets/jaeu/og-home.jpg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${new URL('/', site).href}#website`,
      url: new URL('/', site).href,
      name: org.shortName,
      inLanguage: 'ru',
      publisher: { '@id': `${new URL('/', site).href}#organization` }
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: meta.title,
      description: meta.description,
      inLanguage: 'ru',
      isPartOf: { '@id': `${new URL('/', site).href}#website` },
      about: { '@id': `${new URL('/', site).href}#organization` }
    },
    {
      '@type': 'Organization',
      '@id': `${new URL('/', site).href}#organization`,
      name: org.shortName,
      legalName: org.legalName,
      url: new URL('/', site).href,
      logo: new URL('/assets/jaeu/logo-jaeu.webp', site).href,
      email: org.email,
      telephone: org.phone,
      foundingDate: org.registeredOn,
      address: {
        '@type': 'PostalAddress',
        addressCountry: org.address.country,
        addressRegion: org.address.region,
        addressLocality: org.address.city,
        streetAddress: org.address.street,
        postalCode: org.address.postalCode
      }
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n="meta.title">{meta.title}</title>
    <meta name="description" content={meta.description} data-i18n-attrs="content:meta.description" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#202A57" />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/jaeu-emblem.svg')} />

    {/*
      Языки главной переключаются на одном URL, поэтому hreflang-альтернатив
      на псевдопути не добавляем.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.shortName} />
    <meta property="og:title" content={meta.ogTitle} data-i18n-attrs="content:meta.ogTitle" />
    <meta property="og:description" content={meta.description} data-i18n-attrs="content:meta.description" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} data-i18n-attrs="content:meta.ogTitle" />
    <meta name="twitter:description" content={meta.description} data-i18n-attrs="content:meta.description" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="h-body">
    <a class="h-skip" href="#main" data-i18n="ui.skip">Перейти к содержимому</a>
    <SiteHeader currentPath="/" />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <I18nRuntime payload={homeI18nPayload} />
    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
