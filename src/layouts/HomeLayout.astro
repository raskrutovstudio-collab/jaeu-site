---
import '../styles/home.css';
import SiteHeader from '../components/home/SiteHeader.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { faq, meta, org } from '../data/home';
import { homeI18nPayload } from '../data/homeI18n';
import { canonicalUrl, productionOrigin, withBase } from '../data/site';

const site = new URL(productionOrigin);
const canonical = canonicalUrl('/');
const ogImage = new URL('/assets/jaeu/og-home.jpg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${new URL('/', site).href}#website`,
      url: new URL('/', site).href,
      name: org.shortName,
      inLanguage: 'ru',
      publisher: { '@id': `${new URL('/', site).href}#organization` }
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: meta.title,
      description: meta.description,
      inLanguage: 'ru',
      isPartOf: { '@id': `${new URL('/', site).href}#website` },
      about: { '@id': `${new URL('/', site).href}#organization` }
    },
    {
      '@type': 'Organization',
      '@id': `${new URL('/', site).href}#organization`,
      name: org.shortName,
      legalName: org.legalName,
      url: new URL('/', site).href,
      logo: new URL('/assets/jaeu/logo-jaeu.webp', site).href,
      email: org.email,
      telephone: org.phone,
      foundingDate: org.registeredOn,
      address: {
        '@type': 'PostalAddress',
        addressCountry: org.address.country,
        addressRegion: org.address.region,
        addressLocality: org.address.city,
        streetAddress: org.address.street,
        postalCode: org.address.postalCode
      }
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n="meta.title">{meta.title}</title>
    <meta name="description" content={meta.description} data-i18n-attrs="content:meta.description" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#202A57" />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/jaeu-emblem.svg')} />

    {/*
      Языки главной переключаются на одном URL, поэтому hreflang-альтернатив
      у этой страницы нет: индексируется только русская версия.
      Маршруты /kz/ и /en/ сохранены, их SEO не менялось.
    */}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={org.shortName} />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ассоциация ювелиров ЕАЭС" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Inter:wght@400;500;600&display=swap"
    />
    <link
      rel="preload"
      as="image"
      href={withBase('/assets/jaeu/hero-1600.webp')}
      imagesrcset={`${withBase('/assets/jaeu/hero-760.webp')} 760w, ${withBase('/assets/jaeu/hero-1100.webp')} 1100w, ${withBase('/assets/jaeu/hero-1600.webp')} 1536w`}
      imagesizes="(min-width: 1041px) 50vw, 100vw"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline>
      // Начальное состояние reveal включаем до отрисовки, иначе контент мигнёт.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.motion = 'on';
      }
    </script>
  </head>

  <body class="h-body">
    <a class="h-skip" href="#main" data-i18n="ui.skip">Перейти к содержимому</a>
    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    {/*
      Экспериментальная локализация одной страницы без смены URL.
      Скрипт стоит в конце body и выполняется синхронно: разметка уже
      разобрана, а первая отрисовка ещё не произошла, поэтому сохранённый
      язык применяется без мигания и без сдвига layout.
      Русские строки берутся из самой разметки, а не из полезной нагрузки,
      поэтому без JavaScript страница остаётся полноценно русской.
    */}
    <script is:inline define:vars={{ i18n: homeI18nPayload }}>
      (() => {
        const root = document.documentElement;
        const langAttr = new Map(i18n.locales.map((item) => [item.id, item.lang]));
        const texts = [];
        const attrs = [];

        // Заголовок может содержать иконку, поэтому меняется только текстовый узел.
        const firstText = (element) => {
          for (const node of element.childNodes) {
            if (node.nodeType === 3 && node.textContent.trim()) return node;
          }
          return null;
        };

        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const node = firstText(element);
          texts.push({
            key: element.dataset.i18n,
            target: node || element,
            base: node ? node.textContent : element.textContent
          });
        });

        document.querySelectorAll('[data-i18n-attrs]').forEach((element) => {
          element.dataset.i18nAttrs.split(';').forEach((entry) => {
            const separator = entry.indexOf(':');
            if (separator < 1) return;
            const attr = entry.slice(0, separator).trim();
            const key = entry.slice(separator + 1).trim();
            attrs.push({ element, attr, key, base: element.getAttribute(attr) || '' });
          });
        });

        // Ключ без подтверждённого перевода остаётся русским из разметки.
        const resolve = (locale, key, base) => {
          if (locale === 'ru') return base;
          const table = i18n.overrides[locale];
          return (table && table[key]) || base;
        };

        let current = 'ru';

        const apply = (locale) => {
          const next = langAttr.has(locale) ? locale : 'ru';
          current = next;
          root.lang = langAttr.get(next);
          texts.forEach((item) => {
            item.target.textContent = resolve(next, item.key, item.base);
          });
          attrs.forEach((item) => {
            item.element.setAttribute(item.attr, resolve(next, item.key, item.base));
          });
          document.dispatchEvent(new CustomEvent('jaeu:lang', { detail: next }));
        };

        window.jaeuLang = {
          storageKey: i18n.storageKey,
          locales: i18n.locales.map((item) => item.id),
          apply,
          get current() {
            return current;
          }
        };

        let stored = null;
        try {
          stored = localStorage.getItem(i18n.storageKey);
        } catch {
          stored = null;
        }
        if (stored && stored !== 'ru') apply(stored);
      })();
    </script>

    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
