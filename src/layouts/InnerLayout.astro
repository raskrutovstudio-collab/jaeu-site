---
/*
  Лейаут внутренних страниц.

  Шапка, футер, токены и типографика взяты те же, что у утверждённой главной
  (`home.css`, `SiteHeader`, `SiteFooter`), поэтому внутренние страницы
  читаются как её продолжение. `inner.css` добавляет только композиции,
  которых на главной нет.

  Язык переключается тем же механизмом, что и на главной: русская разметка —
  baseline и единственная индексируемая версия, KZ/EN подставляются на клиенте
  по словарю страницы. URL при переключении не меняется.
*/
import '../styles/inner-entry.css';
import I18nRuntime from '../components/I18nRuntime.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { org } from '../data/home';
import { buildI18nPayload } from '../data/homeI18n';
import { canonicalUrl, productionOrigin, withBase } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  path: string;
  /** Видимая хлебная крошка текущей страницы. */
  crumb: string;
  /** Дополнительные узлы структурированных данных с подтверждёнными фактами. */
  schema?: Record<string, unknown>[];
  /** Перекрытия KZ/EN для ключей `data-i18n` этой страницы. */
  i18n: Record<string, { kk: string; en: string }>;
}

const { title, description, ogTitle, path, crumb, schema = [], i18n } = Astro.props;
const i18nPayload = buildI18nPayload(i18n);

const site = new URL(productionOrigin);
const canonical = canonicalUrl(path);
const homeUrl = new URL('/', site).href;
const ogImage = new URL('/assets/jaeu/og-home.jpg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'ru',
      isPartOf: { '@id': `${homeUrl}#website` },
      about: { '@id': `${homeUrl}#organization` },
      breadcrumb: { '@id': `${canonical}#breadcrumb` }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: org.shortName, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: crumb, item: canonical }
      ]
    },
    ...schema
  ]
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n="meta.title">{title}</title>
    <meta name="description" content={description} data-i18n-attrs="content:meta.description" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#202A57" />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/jaeu-emblem.svg')} />

    <meta property="og:type" content="article" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={org.shortName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={org.shortName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline>
      // Начальное состояние stagger включаем до отрисовки, иначе контент мигнёт.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.motion = 'on';
      }
    </script>
  </head>

  <body class="h-body">
    <a class="h-skip" href="#main" data-i18n="ui.skip">Перейти к содержимому</a>
    <SiteHeader currentPath={path} />

    <main class="p-main" id="main">
      <slot />
    </main>

    <SiteFooter currentPath={path} />

    <I18nRuntime payload={i18nPayload} />

    <script>
      import '../scripts/inner';
    </script>
  </body>
</html>
