---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { activities } from '../../data/pages';
import { activitiesI18n } from '../../data/pagesI18n';
import { routes } from '../../data/home';
import { withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
/* Второй ряд направлений идёт после врезки, поэтому ключи считаются со сдвига. */
const splitAt = 2;
const [firstHalf, secondHalf] = [
  activities.directions.items.slice(0, splitAt),
  activities.directions.items.slice(splitAt)
];
---

<InnerLayout
  title={activities.meta.title}
  description={activities.meta.description}
  ogTitle={activities.meta.ogTitle}
  path={routes.activities}
  crumb={activities.crumb}
  i18n={activitiesI18n}
>
  <section class="p-hero p-hero--belt">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{activities.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">{activities.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{activities.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">{activities.hero.lead}</p>
        </div>

        <figure class="p-hero__media">
          <img
            src={asset('page-activities-expertise-1160.webp')}
            srcset={`${asset('page-activities-expertise-760.webp')} 760w, ${asset('page-activities-expertise-1160.webp')} 1160w`}
            sizes="(min-width: 1041px) 1160px, 100vw"
            width="1160"
            height="261"
            alt={activities.hero.beltAlt}
            data-i18n-attrs="alt:hero.beltAlt"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="activities-directions" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="activities-directions" data-rise="1" data-i18n="directions.h2">{activities.directions.h2}</h2>
        <hr class="h-rule" />
      </div>

      <div class="p-dirs">
        {firstHalf.map((item, index) => (
          <article class="p-dirs__item" data-rise="2">
            <div class="p-dirs__head">
              <Icon name={item.icon} class="p-dirs__icon" />
              <h3 class="h-h3" data-i18n={`directions.items.${index}.title`}>{item.title}</h3>
            </div>
            <div class="p-dirs__body">
              <p class="p-dirs__text" data-i18n={`directions.items.${index}.text`}>{item.text}</p>
              {item.practice && (
                <p class="p-dirs__practice" data-i18n={`directions.items.${index}.practice`}>{item.practice}</p>
              )}
              <a class="h-link" href={item.link.href}>
                <span data-i18n={`directions.items.${index}.link.label`}>{item.link.label}</span>
                <Icon name="arrow" class="h-link__arrow" />
              </a>
            </div>
          </article>
        ))}

        <div class="p-inset p-inset--support">
          <p class="p-inset__caption" data-rise="3" data-i18n="directions.mediaCaption">{activities.directions.mediaCaption}</p>
          <figure class="p-inset__media" data-reveal-media>
            <img
              src={asset('page-activities-discussion-1200.webp')}
              srcset={`${asset('page-activities-discussion-760.webp')} 760w, ${asset('page-activities-discussion-1200.webp')} 1200w`}
              sizes="(min-width: 1041px) 760px, 100vw"
              width="1200"
              height="800"
              alt={activities.directions.mediaAlt}
              data-i18n-attrs="alt:directions.mediaAlt"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>

        {secondHalf.map((item, offset) => (
          <article class="p-dirs__item" data-rise="4">
            <div class="p-dirs__head">
              <Icon name={item.icon} class="p-dirs__icon" />
              <h3 class="h-h3" data-i18n={`directions.items.${offset + splitAt}.title`}>{item.title}</h3>
            </div>
            <div class="p-dirs__body">
              <p class="p-dirs__text" data-i18n={`directions.items.${offset + splitAt}.text`}>{item.text}</p>
              {item.practice && (
                <p class="p-dirs__practice" data-i18n={`directions.items.${offset + splitAt}.practice`}>{item.practice}</p>
              )}
              <a class="h-link" href={item.link.href}>
                <span data-i18n={`directions.items.${offset + splitAt}.link.label`}>{item.link.label}</span>
                <Icon name="arrow" class="h-link__arrow" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="activities-tasks" data-reveal>
    <div class="h-shell">
      <div class="p-split p-split--compact">
        <div class="p-split__body">
          <h2 class="h-h2" id="activities-tasks" data-rise="1" data-i18n="tasks.h2">{activities.tasks.h2}</h2>
          <hr class="h-rule" />
          <p class="h-text" data-rise="2" data-i18n="tasks.lead">{activities.tasks.lead}</p>

          <ul class="h-points" data-rise="3">
            {activities.tasks.items.map((item, index) => (
              <li class="h-points__item">
                <h3 class="h-h3 h-points__title" data-i18n={`tasks.items.${index}.title`}>{item.title}</h3>
                <p class="h-points__text" data-i18n={`tasks.items.${index}.text`}>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>

        <figure class="p-split__media" data-reveal-media>
          <img
            src={asset('page-activities-balance-1000.webp')}
            srcset={`${asset('page-activities-balance-600.webp')} 600w, ${asset('page-activities-balance-1000.webp')} 1000w`}
            sizes="(min-width: 1041px) 420px, 100vw"
            width="1000"
            height="1250"
            alt={activities.tasks.imageAlt}
            data-i18n-attrs="alt:tasks.imageAlt"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="activities-flow" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="activities-flow" data-rise="1" data-i18n="flow.h2">{activities.flow.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2" data-i18n="flow.lead">{activities.flow.lead}</p>
      </div>

      <ul class="p-cols p-cols--3" data-rise="3">
        {activities.flow.steps.map((step, index) => (
          <li class="p-cols__item">
            <h3 class="h-h3 p-cols__title" data-i18n={`flow.steps.${index}.title`}>{step.title}</h3>
            <p class="p-cols__text" data-i18n={`flow.steps.${index}.text`}>{step.text}</p>
          </li>
        ))}
      </ul>

      <figure class="p-belt p-belt--wide p-belt--tail" data-reveal-media>
        <img
          src={asset('page-activities-workshop-1400.webp')}
          srcset={`${asset('page-activities-workshop-900.webp')} 900w, ${asset('page-activities-workshop-1400.webp')} 1400w`}
          sizes="(min-width: 1041px) 1160px, 100vw"
          width="1400"
          height="600"
          alt={activities.flow.imageAlt}
          data-i18n-attrs="alt:flow.imageAlt"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="activities-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="activities-cta" data-rise="1" data-i18n="cta.h2">{activities.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{activities.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a class="h-btn h-btn--light" href={activities.cta.primary.href}>
            <span data-i18n="cta.primary.label">{activities.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={activities.cta.secondary.href}>
            <span data-i18n="cta.secondary.label">{activities.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
