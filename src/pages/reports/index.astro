---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { reports } from '../../data/pages';
import { reportsI18n } from '../../data/pagesI18n';
import { routes } from '../../data/home';
import { withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
---

<InnerLayout
  title={reports.meta.title}
  description={reports.meta.description}
  ogTitle={reports.meta.ogTitle}
  path={routes.reports}
  crumb={reports.crumb}
  i18n={reportsI18n}
>
  <section class="p-hero p-hero--tight">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{reports.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">{reports.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{reports.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">{reports.hero.lead}</p>

          <a
            class="p-hero__link"
            href={reports.hero.action.href}
            data-i18n-attrs="href:hero.action.href"
          >
            <span data-i18n="hero.action.label">{reports.hero.action.label}</span>
            <Icon name="arrow" class="p-hero__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Состав материалов виден в первом экране, поэтому идёт без reveal. -->
  <section class="h-section h-section--white" aria-labelledby="reports-materials">
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="reports-materials" data-i18n="materials.h2">{reports.materials.h2}</h2>
        <hr class="h-rule" />
      </div>

      <dl class="p-facts">
        {reports.materials.items.map((item, index) => (
          <>
            <dt data-i18n={`materials.items.${index}.term`}>{item.term}</dt>
            <dd data-i18n={`materials.items.${index}.value`}>{item.value}</dd>
          </>
        ))}
      </dl>
      <p class="p-note" data-i18n="materials.note">{reports.materials.note}</p>

      <div class="p-slab">
        <div>
          <h2 class="h-h3 p-slab__title" data-i18n="access.h2">{reports.access.h2}</h2>
          <p class="p-slab__text" data-i18n="access.text">{reports.access.text}</p>
        </div>

        <div class="p-slab__action">
          <a
            class="h-btn h-btn--light"
            href={reports.access.action.href}
            data-i18n-attrs="href:access.action.href"
          >
            <span data-i18n="access.action.label">{reports.access.action.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="reports-outcomes" data-reveal>
    <div class="h-shell">
      <div class="p-year">
        <p class="p-year__mark" aria-hidden="true" data-rise="1">{reports.outcomes.year}</p>

        <div class="p-head">
          <h2 class="h-h2" id="reports-outcomes" data-rise="1" data-i18n="outcomes.h2">{reports.outcomes.h2}</h2>
          <hr class="h-rule" />
          <p class="h-text" data-rise="2" data-i18n="outcomes.lead">{reports.outcomes.lead}</p>
        </div>
      </div>

      <ul class="p-cols p-cols--2" data-rise="3">
        {reports.outcomes.items.map((item, index) => (
          <li class="p-cols__item">
            <h3 class="h-h3 p-cols__title" data-i18n={`outcomes.items.${index}.title`}>{item.title}</h3>
            <p class="p-cols__text" data-i18n={`outcomes.items.${index}.text`}>{item.text}</p>
          </li>
        ))}
      </ul>

      <figure class="p-belt p-belt--wide p-belt--tail" data-reveal-media>
        <img
          src={asset('page-reports-belt-1160.webp')}
          srcset={`${asset('page-reports-belt-760.webp')} 760w, ${asset('page-reports-belt-1160.webp')} 1160w`}
          sizes="(min-width: 1041px) 1160px, 100vw"
          width="1160"
          height="497"
          alt={reports.belt.alt}
          data-i18n-attrs="alt:belt.alt"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="reports-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="reports-cta" data-rise="1" data-i18n="cta.h2">{reports.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{reports.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a
            class="h-btn h-btn--light"
            href={reports.cta.primary.href}
            data-i18n-attrs="href:cta.primary.href"
          >
            <span data-i18n="cta.primary.label">{reports.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={reports.cta.secondary.href}>
            <span data-i18n="cta.secondary.label">{reports.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
