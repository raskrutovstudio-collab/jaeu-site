---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { expertCouncil as council } from '../../data/pages';
import { expertCouncilI18n } from '../../data/pagesI18n';
import { routes } from '../../data/home';
import { withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);

const councilI18n = {
  ...expertCouncilI18n,
  'compliance.h2': {
    kk: 'Қазақстан Республикасының КЖ/ТҚҚ/ЖҚҚТҚ саласындағы заңнама талаптарының сақталуын бақылау',
    en: 'Monitoring compliance with the legislation of the Republic of Kazakhstan in the AML/CFT/CPF field'
  },
  'compliance.paragraphs.0': {
    kk: 'Қауымдастық мүшелерінің қылмыстық жолмен алынған кірістерді заңдастыруға, терроризмді қаржыландыруға және жаппай қырып-жою қаруын таратуды қаржыландыруға қарсы іс-қимыл саласындағы Қазақстан Республикасы заңнамасының талаптарын сақтауына жәрдемдесу мақсатында Кеңес өз құзыреті шегінде осы талаптардың сақталуын мониторингтейді, келіп түскен материалдар мен мәліметтерді қарайды және заңнама талаптарының орындалуын бағалау үшін маңызы бар мән-жайларды талдайды.',
    en: 'To support members of the Association in complying with the legislation of the Republic of Kazakhstan on anti-money laundering, counter-terrorist financing and counter-proliferation financing, the Council monitors compliance within its competence, reviews submitted materials and information, and analyses circumstances relevant to assessing compliance with the applicable requirements.'
  },
  'compliance.paragraphs.1': {
    kk: 'Қазақстан Республикасының КЖ/ТҚҚ/ЖҚҚТҚ саласындағы заңнамасында белгіленген мінсіз іскерлік бедел талаптарына сәйкес келмейтін заңды және жеке тұлғалар Қауымдастық мүшесі бола алмайды. Бұл талаптарға сәйкестік мүшелікке кіру және оны сақтау үшін міндетті шарт болып табылады.',
    en: 'Legal entities and individuals that do not meet the requirements for an impeccable business reputation established by the legislation of the Republic of Kazakhstan in the AML/CFT/CPF field may not be members of the Association. Compliance with these requirements is a mandatory condition for acquiring and retaining membership.'
  },
  'compliance.paragraphs.2': {
    kk: 'Кеңес Қауымдастық мүшелерінің мінсіз іскерлік бедел талаптарына сәйкестігін бағалайды, КЖ/ТҚҚ/ЖҚҚТҚ саласындағы заңнаманы бұзу туралы мәліметтерді қарайды және осы заңнама талаптарын жүйелі түрде орындамау не тиісінше орындамау фактілерін талдайды.',
    en: 'The Council assesses whether members of the Association meet the requirements for an impeccable business reputation, reviews information on breaches of AML/CFT/CPF legislation, and analyses cases of systematic failure or improper performance of the requirements of that legislation.'
  }
};
---

<InnerLayout
  title={council.meta.title}
  description={council.meta.description}
  ogTitle={council.meta.ogTitle}
  path={routes.expertCouncil}
  crumb={council.crumb}
  i18n={councilI18n}
>
  <section class="p-hero p-hero--split">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{council.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">{council.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{council.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">{council.hero.lead}</p>
          <p class="p-hero__note" data-i18n="hero.note">{council.hero.note}</p>
        </div>

        <figure class="p-hero__media">
          <img
            src={asset('page-council-group-1400.webp')}
            srcset={`${asset('page-council-group-900.webp')} 900w, ${asset('page-council-group-1400.webp')} 1400w`}
            sizes="(min-width: 1041px) 660px, 100vw"
            width="1400"
            height="600"
            alt={council.hero.imageAlt}
            data-i18n-attrs="alt:hero.imageAlt"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="council-expertise" data-reveal>
    <div class="h-shell">
      <div class="p-split p-split--editorial">
        <div class="p-split__body p-article">
          <h2 class="h-h2" id="council-expertise" data-rise="1" data-i18n="expertise.h2">{council.expertise.h2}</h2>
          <hr class="h-rule" />
          {council.expertise.paragraphs.slice(0, 2).map((text, index) => (
            <p class="h-text" data-rise={String(index + 2)} data-i18n={`expertise.paragraphs.${index}`}>{text}</p>
          ))}
        </div>

        <figure class="p-split__media" data-reveal-media>
          <img
            src={asset('page-council-stone-1100.webp')}
            srcset={`${asset('page-council-stone-700.webp')} 700w, ${asset('page-council-stone-1100.webp')} 1100w`}
            sizes="(min-width: 1041px) 460px, 100vw"
            width="1100"
            height="1467"
            alt={council.expertise.imageAlt}
            data-i18n-attrs="alt:expertise.imageAlt"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="p-article p-editorial__rest">
        {council.expertise.paragraphs.slice(2).map((text, index) => (
          <p class="h-text" data-i18n={`expertise.paragraphs.${index + 2}`}>{text}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="council-compliance" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="council-compliance" data-rise="1" data-i18n="compliance.h2">{council.compliance.h2}</h2>
        <hr class="h-rule" />
      </div>
      <div class="p-article">
        {council.compliance.paragraphs.map((text, index) => (
          <p data-i18n={`compliance.paragraphs.${index}`}>{text}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="council-principles" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="council-principles" data-rise="1" data-i18n="principles.h2">{council.principles.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2" data-i18n="principles.lead">{council.principles.lead}</p>
      </div>

      <ul class="p-cols p-cols--2" data-rise="3">
        {council.principles.items.map((item, index) => (
          <li class="p-cols__item">
            <h3 class="h-h3 p-cols__title" data-i18n={`principles.items.${index}.title`}>{item.title}</h3>
            <p class="p-cols__text" data-i18n={`principles.items.${index}.text`}>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="council-topics" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="council-topics" data-rise="1" data-i18n="topics.h2">{council.topics.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2" data-i18n="topics.lead">{council.topics.lead}</p>
      </div>

      <ul class="p-cols p-cols--3" data-rise="3">
        {council.topics.items.map((item, index) => (
          <li class="p-cols__item">
            <h3 class="h-h3 p-cols__title" data-i18n={`topics.items.${index}.title`}>{item.title}</h3>
            <p class="p-cols__text" data-i18n={`topics.items.${index}.text`}>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="council-order" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="council-order" data-rise="1" data-i18n="order.h2">{council.order.h2}</h2>
        <hr class="h-rule" />
      </div>

      <dl class="p-facts" data-rise="2">
        {council.order.items.map((item, index) => (
          <>
            <dt data-i18n={`order.items.${index}.term`}>{item.term}</dt>
            <dd data-i18n={`order.items.${index}.value`}>{item.value}</dd>
          </>
        ))}
      </dl>
      <p class="p-note" data-rise="3" data-i18n="order.note">{council.order.note}</p>

      <figure class="p-belt p-belt--tail" data-reveal-media>
        <img
          src={asset('page-council-table-1160.webp')}
          srcset={`${asset('page-council-table-760.webp')} 760w, ${asset('page-council-table-1160.webp')} 1160w`}
          sizes="(min-width: 1041px) 1160px, 100vw"
          width="1160"
          height="326"
          alt={council.order.tableAlt}
          data-i18n-attrs="alt:order.tableAlt"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="council-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="council-cta" data-rise="1" data-i18n="cta.h2">{council.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{council.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a class="h-btn h-btn--light" href={council.cta.primary.href}>
            <span data-i18n="cta.primary.label">{council.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={council.cta.secondary.href}>
            <span data-i18n="cta.secondary.label">{council.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
