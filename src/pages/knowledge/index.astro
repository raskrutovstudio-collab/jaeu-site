---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { knowledge } from '../../data/pages';
import { knowledgeI18n } from '../../data/pagesI18n';
import { org, routes } from '../../data/home';
import { withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
---

<InnerLayout
  title={knowledge.meta.title}
  description={knowledge.meta.description}
  ogTitle={knowledge.meta.ogTitle}
  path={routes.knowledge}
  crumb={knowledge.crumb}
  i18n={knowledgeI18n}
>
  <section class="p-hero p-hero--tight">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{knowledge.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">{knowledge.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{knowledge.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">{knowledge.hero.lead}</p>

          <nav class="p-toc" aria-label={knowledge.toc.label} data-i18n-attrs="aria-label:toc.label">
            {knowledge.toc.items.map((item, index) => (
              <a href={item.href} data-i18n={`toc.items.${index}.label`}>{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- Навигация открывается сразу: reveal подключён только к секциям ниже. -->
  <section class="h-section h-section--white" aria-labelledby="knowledge-start">
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="knowledge-start" data-i18n="start.h2">{knowledge.start.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-i18n="start.lead">{knowledge.start.lead}</p>
      </div>

      <ul class="p-paths">
        {knowledge.start.items.map((item, index) => (
          <li class="p-paths__item">
            <h3 class="h-h3 p-paths__title" data-i18n={`start.items.${index}.title`}>{item.title}</h3>
            <p class="p-paths__text" data-i18n={`start.items.${index}.text`}>{item.text}</p>
            <a class="p-paths__link" href={item.link.href}>
              <span data-i18n={`start.items.${index}.link.label`}>{item.link.label}</span>
              <Icon name="arrow" class="p-lib__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    class="h-section h-section--stone"
    aria-label="Навигация по материалам"
    data-i18n-attrs="aria-label:list.aria"
    data-reveal
  >
    <div class="h-shell">
      <p class="p-hint p-hint--head" data-rise="1" data-i18n="listNote">{knowledge.listNote}</p>

      <div class="p-guide" data-rise="2">
        {knowledge.groups.map((group, index) => (
          <section class="p-guide__group" id={group.id} aria-labelledby={`${group.id}-title`}>
            <div class="p-guide__aside">
              <h2 class="h-h3" id={`${group.id}-title`} data-i18n={`groups.${index}.title`}>{group.title}</h2>
              <hr class="h-rule" />
              <p class="p-guide__lead" data-i18n={`groups.${index}.lead`}>{group.lead}</p>
            </div>

            <ul class="p-guide__rows">
              {group.items.map((item, itemIndex) => (
                <li class="p-guide__row">
                  <a class="p-guide__link" href={item.href}>
                    <span class="p-guide__name">
                      <span data-i18n={`groups.${index}.items.${itemIndex}.label`}>{item.label}</span>
                      <Icon name="arrow" class="p-guide__arrow" />
                    </span>
                    <span class="p-guide__text" data-i18n={`groups.${index}.items.${itemIndex}.text`}>{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="knowledge-expertise" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="knowledge-expertise" data-rise="1" data-i18n="expertise.h2">{knowledge.expertise.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2" data-i18n="expertise.lead">{knowledge.expertise.lead}</p>
      </div>

      <ul class="p-cols p-cols--3" data-rise="3">
        {knowledge.expertise.items.map((item, index) => (
          <li class="p-cols__item">
            <h3 class="h-h3 p-cols__title" data-i18n={`expertise.items.${index}.title`}>{item.title}</h3>
            <p class="p-cols__text" data-i18n={`expertise.items.${index}.text`}>{item.text}</p>
          </li>
        ))}
      </ul>

      <div class="p-inset p-inset--wide">
        <p class="p-inset__caption" data-i18n="expertise.caption">{knowledge.expertise.caption}</p>

        <figure class="p-inset__media" data-reveal-media>
          <img
            src={asset('documents-desk-1160.webp')}
            srcset={`${asset('documents-desk-760.webp')} 760w, ${asset('documents-desk-1160.webp')} 1160w`}
            sizes="(min-width: 1041px) 760px, 100vw"
            width="1160"
            height="261"
            alt={knowledge.expertise.imageAlt}
            data-i18n-attrs="alt:expertise.imageAlt"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="knowledge-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="knowledge-cta" data-rise="1" data-i18n="cta.h2">{knowledge.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{knowledge.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a
            class="h-btn h-btn--light"
            href={knowledge.cta.primary.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Написать на ${org.email} в Gmail`}
            data-i18n-attrs="href:cta.primary.href;aria-label:ui.writeEmailGmail"
          >
            <span data-i18n="cta.primary.label">{knowledge.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={knowledge.cta.secondary.href}>
            <span data-i18n="cta.secondary.label">{knowledge.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
