---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { knowledge } from '../../data/pages';
import { routes } from '../../data/home';
import { withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
---

<InnerLayout
  title={knowledge.meta.title}
  description={knowledge.meta.description}
  ogTitle={knowledge.meta.ogTitle}
  path={routes.knowledge}
  crumb={knowledge.crumb}
>
  <section class="p-hero p-hero--tight">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки">
            <a href={routes.home}>Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{knowledge.crumb}</span>
          </nav>
          <p class="h-eyebrow">{knowledge.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title">{knowledge.hero.h1}</h1>
          <p class="h-lead p-hero__lead">{knowledge.hero.lead}</p>
          <p class="p-hero__note">{knowledge.hero.note}</p>

          <nav class="p-toc" aria-label={knowledge.toc.label}>
            {knowledge.toc.items.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- Навигация открывается сразу: reveal подключён только к секциям ниже. -->
  <section class="h-section h-section--white" aria-label="Навигация по материалам">
    <div class="h-shell">
      <div class="p-guide">
        {knowledge.groups.map((group) => (
          <section class="p-guide__group" id={group.id} aria-labelledby={`${group.id}-title`}>
            <div class="p-guide__aside">
              <h2 class="h-h3" id={`${group.id}-title`}>{group.title}</h2>
              <hr class="h-rule" />
              <p class="p-guide__lead">{group.lead}</p>
            </div>

            <ul class="p-guide__rows">
              {group.items.map((item) => (
                <li class="p-guide__row">
                  <a class="p-guide__link" href={item.href}>
                    <span class="p-guide__name">
                      <span>{item.label}</span>
                      <Icon name="arrow" class="p-guide__arrow" />
                    </span>
                    <span class="p-guide__text">{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="knowledge-expertise" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="knowledge-expertise" data-rise="1">{knowledge.expertise.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2">{knowledge.expertise.lead}</p>
      </div>

      <ul class="p-cols p-cols--3" data-rise="3">
        {knowledge.expertise.items.map((item) => (
          <li class="p-cols__item">
            <h3 class="h-h3 p-cols__title">{item.title}</h3>
            <p class="p-cols__text">{item.text}</p>
          </li>
        ))}
      </ul>

      <div class="p-inset">
        <p class="p-inset__caption">{knowledge.expertise.caption}</p>

        <figure class="p-inset__media" data-reveal-media>
          <img
            src={asset('about-detail-1200.webp')}
            srcset={`${asset('about-detail-760.webp')} 760w, ${asset('about-detail-1200.webp')} 1200w`}
            sizes="(min-width: 1041px) 760px, 100vw"
            width="1200"
            height="800"
            alt={knowledge.expertise.imageAlt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="knowledge-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="knowledge-cta" data-rise="1">{knowledge.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2">{knowledge.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a class="h-btn h-btn--light" href={knowledge.cta.primary.href}>
            <span>{knowledge.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={knowledge.cta.secondary.href}>
            <span>{knowledge.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
