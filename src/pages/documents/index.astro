---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { documents } from '../../data/pages';
import { documentsI18n } from '../../data/pagesI18n';
import { org, routes } from '../../data/home';
import { gmailCompose } from '../../data/mail';
import { withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);

const requestHref = (title: string) =>
  gmailCompose(`${documents.action.prefix}: ${title}`);

/*
  «Документы» содержат только самостоятельные официальные материалы.
  Вступление и взносы полностью раскрыты на /membership/.
  Мероприятия и результаты работы полностью раскрыты на /news/.
*/
const visibleGroups = documents.groups
  .map((group, sourceIndex) => ({ group, sourceIndex }))
  .filter(({ sourceIndex }) => sourceIndex === 1 || sourceIndex === 3);
---

<InnerLayout
  title={documents.meta.title}
  description={documents.meta.description}
  ogTitle={documents.meta.ogTitle}
  path={routes.documents}
  crumb={documents.crumb}
  i18n={documentsI18n}
>
  <section class="p-hero p-hero--tight">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{documents.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">Документы и материалы</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{documents.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">
            Официальные положения и справочные материалы Ассоциации, которые не дублируют тематические разделы сайта. Копии предоставляются по запросу.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-label="Перечень документов" data-i18n-attrs="aria-label:list.aria">
    <div class="h-shell">
      <div class="p-lib">
        {visibleGroups.map(({ group, sourceIndex }, visibleIndex) => (
          <section class="p-lib__group" aria-labelledby={`documents-group-${sourceIndex}`}>
            <h2 class="h-h3 p-lib__title" id={`documents-group-${sourceIndex}`} data-i18n={`groups.${sourceIndex}.title`}>{group.title}</h2>

            <ul class="p-lib__rows">
              {group.items.map((item, itemIndex) => (
                <li class="p-lib__row">
                  <div>
                    <p class="p-lib__name" data-i18n={`groups.${sourceIndex}.items.${itemIndex}.title`}>{item.title}</p>
                    <p class="p-lib__text" data-i18n={`groups.${sourceIndex}.items.${itemIndex}.text`}>{item.text}</p>
                  </div>

                  <div class="p-lib__side">
                    <a
                      class="p-lib__action"
                      href={requestHref(item.title)}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${documents.action.label} в Gmail: ${item.title}`}
                      data-i18n-attrs={`href:groups.${sourceIndex}.items.${itemIndex}.actionHref;aria-label:groups.${sourceIndex}.items.${itemIndex}.actionAria`}
                    >
                      <span data-i18n="action.label">{documents.action.label}</span>
                      <Icon name="arrow" class="p-lib__arrow" />
                    </a>

                    {'link' in item && item.link ? (
                      <a class="p-lib__ref" href={item.link.href}>
                        <span data-i18n={`groups.${sourceIndex}.items.${itemIndex}.link.label`}>{item.link.label}</span>
                        <Icon name="arrow" class="p-lib__arrow" />
                      </a>
                    ) : null}
                  </div>
                </li>
              ))}
            </ul>

            {visibleIndex === 0 && <p class="p-hint" data-i18n="listNote">Копии материалов предоставляются по запросу в Ассоциацию.</p>}
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="documents-access" data-reveal>
    <div class="h-shell">
      <figure class="p-belt" data-reveal-media>
        <img
          src={asset('page-documents-belt-1160.webp')}
          srcset={`${asset('page-documents-belt-760.webp')} 760w, ${asset('page-documents-belt-1160.webp')} 1160w`}
          sizes="(min-width: 1041px) 1160px, 100vw"
          width="1160"
          height="326"
          alt={documents.belt.alt}
          data-i18n-attrs="alt:belt.alt"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="p-head p-head--belt">
        <h2 class="h-h2" id="documents-access" data-rise="1" data-i18n="access.h2">{documents.access.h2}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2" data-i18n="access.text">{documents.access.text}</p>
      </div>

      <p class="p-note" data-rise="3" data-i18n="access.note">{documents.access.note}</p>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="documents-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="documents-cta" data-rise="1" data-i18n="cta.h2">Запросить документ</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">Укажите название документа в обращении — Ассоциация подтвердит его доступность и форму предоставления.</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a
            class="h-btn h-btn--light"
            href={documents.cta.primary.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Написать на ${org.email} в Gmail`}
            data-i18n-attrs="href:cta.primary.href;aria-label:ui.writeEmailGmail"
          >
            <span data-i18n="cta.primary.label">{documents.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={routes.contacts}>
            <span data-i18n="nav.contacts">Контакты</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
