---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { news } from '../../data/pages';
import { newsI18n } from '../../data/pagesI18n';
import { org, routes } from '../../data/home';
import { canonicalUrl, withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
const canonical = canonicalUrl(routes.news);

/* Квадратные превью материалов существуют в двух ширинах: 240 и 400 px. */
const thumb = 400;

const featuredLead = news.featured.paragraphs[0];
const featuredRest = news.featured.paragraphs.slice(1);

type NewsItem = (typeof news.items)[number];

const newsFields = (item: NewsItem) => ({
  article: 'article' in item ? Boolean(item.article) : false,
  paragraphs: 'paragraphs' in item ? item.paragraphs : undefined,
  points: 'points' in item ? item.points : undefined,
  text: 'text' in item ? item.text : undefined,
  result: 'result' in item ? item.result : undefined
});

const itemDescription = (item: NewsItem) => {
  const fields = newsFields(item);
  return fields.paragraphs?.[0] || fields.text || '';
};

const itemsByYear = [...new Set(news.items.map((item) => item.date.slice(0, 4)))].map((year) => ({
  year,
  entries: news.items
    .map((item, index) => ({ item, index }))
    .filter(({ item }) => item.date.slice(0, 4) === year)
}));

/* Список отражает видимые на странице материалы с подтверждёнными датами. */
const newsSchema = {
  '@type': 'ItemList',
  '@id': `${canonical}#newslist`,
  name: news.meta.title,
  numberOfItems: news.items.length + 1,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'NewsArticle',
        headline: news.featured.title,
        datePublished: news.featured.date,
        description: featuredLead,
        inLanguage: 'ru',
        url: canonical
      }
    },
    ...news.items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      item: {
        '@type': 'NewsArticle',
        headline: item.title,
        datePublished: item.date,
        description: itemDescription(item),
        inLanguage: 'ru',
        url: canonical
      }
    }))
  ]
};
---

<InnerLayout
  title={news.meta.title}
  description={news.meta.description}
  ogTitle={news.meta.ogTitle}
  path={routes.news}
  crumb={news.crumb}
  schema={[newsSchema]}
  i18n={newsI18n}
>
  <section class="p-hero p-hero--tight">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{news.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">{news.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{news.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">{news.hero.lead}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ведущий материал попадает в первый экран, поэтому идёт без reveal. -->
  <section class="h-section h-section--white" aria-labelledby="news-featured">
    <div class="h-shell">
      <article class="p-story">
        <figure class="p-story__media">
          <img
            src={asset('news-discussion-1000.webp')}
            srcset={`${asset('news-discussion-660.webp')} 660w, ${asset('news-discussion-1000.webp')} 1000w`}
            sizes="(min-width: 1041px) 680px, 100vw"
            width="1000"
            height="563"
            alt={news.featured.imageAlt}
            data-i18n-attrs="alt:featured.imageAlt"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <div class="p-story__body">
          <p class="p-label" data-i18n="featured.eyebrow">{news.featured.eyebrow}</p>
          <!-- Меняется только видимая подпись: datetime остаётся машинным. -->
          <time class="p-date" datetime={news.featured.date} data-i18n="featured.dateLabel">{news.featured.dateLabel}</time>
          <h2 class="h-h2 p-story__title" id="news-featured" data-i18n="featured.title">{news.featured.title}</h2>
          <hr class="h-rule" />
          <p class="p-story__text">{featuredLead}</p>
        </div>

        <div class="p-story__continue p-article">
          {featuredRest.map((text) => (
            <>
              <p class="p-story__text">{text}</p>
              {news.featured.points && text.trim().endsWith(':') && (
                <ul>
                  {news.featured.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
            </>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section
    class="h-section h-section--stone"
    aria-label="Другие материалы"
    data-i18n-attrs="aria-label:list.aria"
    data-reveal
  >
    <div class="h-shell">
      <p class="p-hint p-hint--head" data-rise="1" data-i18n="listNote">{news.listNote}</p>

      {itemsByYear.map((group) => (
        <section class="p-stories__group" aria-labelledby={`news-year-${group.year}`}>
          <h2 class="p-stories__year" id={`news-year-${group.year}`}>{group.year}</h2>
          <ul class="p-stories" data-rise="1">
            {group.entries.map(({ item, index }) => {
              const fields = newsFields(item);
              return (
              <li>
                <article class:list={['p-stories__item', fields.article && 'p-stories__item--article']}>
                  <div class="p-stories__meta">
                    <time class="p-date" datetime={item.date} data-i18n={`items.${index}.dateLabel`}>{item.dateLabel}</time>
                  </div>

                  <div class:list={['p-stories__body', 'p-article']}>
                    <h3 class="h-h3 p-stories__title" data-i18n={`items.${index}.title`}>{item.title}</h3>
                    {fields.paragraphs?.map((text) => (
                      <>
                        <p class="p-stories__text">{text}</p>
                        {fields.points && text.trim().endsWith(':') && (
                          <ul>
                            {fields.points.map((point) => (
                              <li>{point}</li>
                            ))}
                          </ul>
                        )}
                      </>
                    ))}
                    {fields.text && !fields.paragraphs && <p class="p-stories__text">{fields.text}</p>}
                    {fields.points && !fields.paragraphs && (
                      <ul>
                        {fields.points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    )}
                    {fields.result && <p class="p-stories__result">{fields.result}</p>}
                  </div>

                  <figure class="p-stories__media" data-reveal-media>
                    <img
                      src={asset(`${item.image}-${thumb}.webp`)}
                      srcset={`${asset(`${item.image}-240.webp`)} 240w, ${asset(`${item.image}-${thumb}.webp`)} 400w`}
                      sizes="(min-width: 1041px) 320px, 260px"
                      width={thumb}
                      height={thumb}
                      alt={item.imageAlt}
                      data-i18n-attrs={`alt:items.${index}.imageAlt`}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                </article>
              </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="p-cta" aria-labelledby="news-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="news-cta" data-rise="1" data-i18n="cta.h2">{news.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{news.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a
            class="h-btn h-btn--light"
            href={news.cta.primary.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Написать на ${org.email} в Gmail`}
            data-i18n-attrs="href:cta.primary.href;aria-label:ui.writeEmailGmail"
          >
            <span data-i18n="cta.primary.label">{news.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={news.cta.secondary.href}>
            <span data-i18n="cta.secondary.label">{news.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
