---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { news } from '../../data/pages';
import { newsI18n } from '../../data/pagesI18n';
import { org, routes } from '../../data/home';
import { canonicalUrl, withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
const canonical = canonicalUrl(routes.news);

const featuredLead = news.featured.paragraphs[0];
const featuredRest = news.featured.paragraphs.slice(1);

type NewsItem = (typeof news.items)[number];

const newsFields = (item: NewsItem) => ({
  article: 'article' in item ? Boolean(item.article) : false,
  paragraphs: 'paragraphs' in item ? item.paragraphs : undefined,
  points: 'points' in item ? item.points : undefined,
  text: 'text' in item ? item.text : undefined,
  result: 'result' in item ? item.result : undefined
});

const itemDescription = (item: NewsItem) => {
  const fields = newsFields(item);
  return fields.paragraphs?.[0] || fields.text || '';
};

const compactVisual = (item: NewsItem, index: number) => {
  if (index === 4) {
    return {
      src: asset('page-council-table-1160.webp'),
      srcset: `${asset('page-council-table-760.webp')} 760w, ${asset('page-council-table-1160.webp')} 1160w`
    };
  }

  if (index === 5) {
    return {
      src: asset('page-council-group-1400.webp'),
      srcset: `${asset('page-council-group-900.webp')} 900w, ${asset('page-council-group-1400.webp')} 1400w`
    };
  }

  return {
    src: asset(`${item.image}-400.webp`),
    srcset: `${asset(`${item.image}-240.webp`)} 240w, ${asset(`${item.image}-400.webp`)} 400w`
  };
};

const itemsByYear = [...new Set(news.items.map((item) => item.date.slice(0, 4)))].map((year) => ({
  year,
  entries: news.items
    .map((item, index) => ({ item, index }))
    .filter(({ item }) => item.date.slice(0, 4) === year)
}));

const newsSchema = {
  '@type': 'ItemList',
  '@id': `${canonical}#newslist`,
  name: news.meta.title,
  numberOfItems: news.items.length + 1,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'NewsArticle',
        headline: news.featured.title,
        datePublished: news.featured.date,
        description: featuredLead,
        inLanguage: 'ru',
        url: canonical
      }
    },
    ...news.items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      item: {
        '@type': 'NewsArticle',
        headline: item.title,
        datePublished: item.date,
        description: itemDescription(item),
        inLanguage: 'ru',
        url: canonical
      }
    }))
  ]
};
---

<InnerLayout
  title={news.meta.title}
  description={news.meta.description}
  ogTitle={news.meta.ogTitle}
  path={routes.news}
  crumb={news.crumb}
  schema={[newsSchema]}
  i18n={newsI18n}
>
  <section class="p-hero p-hero--news p-news-hero">
    <div class="h-shell">
      <div class="p-news-heading">
        <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
          <a href={routes.home} data-i18n="ui.home">Главная</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" data-i18n="crumb">{news.crumb}</span>
        </nav>
        <p class="h-eyebrow" data-i18n="hero.eyebrow">{news.hero.eyebrow}</p>
        <h1 class="h-h1" data-i18n="hero.h1">{news.hero.h1}</h1>
        <p class="h-lead" data-i18n="hero.lead">{news.hero.lead}</p>
      </div>

      <article class="p-featured-news">
        <div class="p-featured-news__top">
          <div class="p-featured-news__content">
            <p class="p-label" data-i18n="featured.eyebrow">{news.featured.eyebrow}</p>
            <time class="p-date" datetime={news.featured.date} data-i18n="featured.dateLabel">{news.featured.dateLabel}</time>
            <h2 class="h-h2" id="news-featured" data-i18n="featured.title">{news.featured.title}</h2>
            <p class="p-story__text p-featured-news__lead" data-i18n="featured.paragraphs.0">{featuredLead}</p>
          </div>

          <figure class="p-featured-news__media">
            <img
              src={asset(`${news.featured.image}-1000.webp`)}
              srcset={`${asset(`${news.featured.image}-660.webp`)} 660w, ${asset(`${news.featured.image}-1000.webp`)} 1000w`}
              sizes="(min-width: 1041px) 650px, 100vw"
              width="1000"
              height="563"
              alt={news.featured.imageAlt}
              data-i18n-attrs="alt:featured.imageAlt"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>

        <div class="p-featured-news__continue p-article" data-lang-only="ru">
          {featuredRest.map((text) => (
            <>
              <p class="p-story__text">{text}</p>
              {news.featured.points && text.trim().endsWith(':') && (
                <ul>{news.featured.points.map((point) => <li>{point}</li>)}</ul>
              )}
            </>
          ))}
        </div>

        <div class="p-featured-news__continue p-article" data-lang-only="translated" hidden>
          <p class="p-story__text" data-i18n="featured.paragraphs.1"></p>
          <p class="p-story__text" data-i18n="featured.paragraphs.2"></p>
        </div>
      </article>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-label="Другие материалы" data-i18n-attrs="aria-label:list.aria" data-reveal>
    <div class="h-shell">
      <p class="p-hint p-hint--head" data-rise="1" data-i18n="listNote">{news.listNote}</p>

      {itemsByYear.map((group) => (
        <section class="p-stories__group" aria-labelledby={`news-year-${group.year}`}>
          <h2 class="p-stories__year" id={`news-year-${group.year}`}>{group.year}</h2>
          <ul class="p-stories" data-rise="1">
            {group.entries.map(({ item, index }) => {
              const fields = newsFields(item);
              const landscape = fields.article;
              const visual = compactVisual(item, index);
              return (
                <li>
                  <article class:list={['p-stories__item', landscape && 'p-stories__item--article', !landscape && 'p-stories__item--compact']}>
                    <div class="p-stories__meta">
                      <time class="p-date" datetime={item.date} data-i18n={`items.${index}.dateLabel`}>{item.dateLabel}</time>
                    </div>

                    <div class:list={['p-stories__body', landscape && 'p-stories__body--editorial']}>
                      <h3 class="h-h3 p-stories__title" data-i18n={`items.${index}.title`}>{item.title}</h3>

                      {landscape && (
                        <figure class="p-stories__media p-stories__media--float">
                          <img
                            src={asset(`${item.image}-760.webp`)}
                            srcset={`${asset(`${item.image}-400.webp`)} 400w, ${asset(`${item.image}-760.webp`)} 760w`}
                            sizes="(min-width: 1041px) 340px, 100vw"
                            width="760"
                            height="428"
                            alt={item.imageAlt}
                            data-i18n-attrs={`alt:items.${index}.imageAlt`}
                            loading="lazy"
                            decoding="async"
                          />
                        </figure>
                      )}

                      <div class:list={[landscape && 'p-stories__copy', 'p-article']} data-lang-only="ru">
                        {fields.paragraphs?.map((text) => (
                          <>
                            <p class="p-stories__text">{text}</p>
                            {fields.points && text.trim().endsWith(':') && (
                              <ul>{fields.points.map((point) => <li>{point}</li>)}</ul>
                            )}
                          </>
                        ))}
                        {fields.text && !fields.paragraphs && <p class="p-stories__text">{fields.text}</p>}
                        {fields.points && !fields.paragraphs && <ul>{fields.points.map((point) => <li>{point}</li>)}</ul>}
                        {fields.result && <p class="p-stories__result">{fields.result}</p>}
                      </div>

                      <div class:list={[landscape && 'p-stories__copy', 'p-article']} data-lang-only="translated" hidden>
                        <p class="p-stories__text" data-i18n={`items.${index}.text`}></p>
                        <p class="p-stories__text" data-i18n={`items.${index}.detail`}></p>
                      </div>
                    </div>

                    {!landscape && (
                      <figure class="p-stories__media" data-reveal-media>
                        <img
                          src={visual.src}
                          srcset={visual.srcset}
                          sizes="(min-width: 1041px) 250px, 240px"
                          width="400"
                          height="300"
                          alt={item.imageAlt}
                          data-i18n-attrs={`alt:items.${index}.imageAlt`}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    )}
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="p-cta" aria-labelledby="news-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="news-cta" data-rise="1" data-i18n="cta.h2">{news.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{news.cta.text}</p>
        </div>
        <div class="p-cta__actions" data-rise="3">
          <a class="h-btn h-btn--light" href={news.cta.primary.href} target="_blank" rel="noopener noreferrer" aria-label={`Написать на ${org.email} в Gmail`} data-i18n-attrs="href:cta.primary.href;aria-label:ui.writeEmailGmail">
            <span data-i18n="cta.primary.label">{news.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>

<style>
  .p-news-hero { padding: 28px 0 54px; }
  .p-news-heading { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; max-width: 54rem; margin-bottom: 34px; }
  .p-news-heading .h-h1 { font-size: clamp(40px, 4vw, 52px); }
  .p-news-heading .h-lead { max-width: 58ch; font-size: 17px; line-height: 1.5; color: var(--text); }
  .p-featured-news { padding-top: 30px; border-top: 1px solid var(--line); }
  .p-featured-news__top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: start; }
  .p-featured-news__content { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .p-featured-news__content .p-label { margin-bottom: 2px; }
  .p-featured-news__content .h-h2 { font-size: clamp(30px, 3vw, 40px); line-height: 1.12; max-width: 16ch; }
  .p-featured-news__lead { margin: 10px 0 0; font-size: 16px; line-height: 1.62; color: var(--text); }
  .p-featured-news__media { margin: 0; }
  .p-featured-news__media img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .p-featured-news__continue { max-width: 58rem; margin-top: 34px; padding-top: 30px; border-top: 1px solid var(--line-soft); }
  .p-featured-news__continue.p-article .p-story__text,
  .p-featured-news__continue.p-article li { font-size: 16px; line-height: 1.68; }
  .p-stories__item--article { grid-template-columns: minmax(7rem, 1.45fr) minmax(0, 10.55fr); column-gap: 34px; padding: 34px 0 40px; }
  .p-stories__body--editorial { display: block; }
  .p-stories__body--editorial .p-stories__title { margin: 0 0 18px; max-width: 34ch; }
  .p-stories__media--float { float: right; width: min(38%, 22rem); margin: 0 0 18px 28px !important; }
  .p-stories__media--float img { aspect-ratio: 4 / 3 !important; object-fit: cover; }
  .p-stories__copy.p-article { display: block; }
  .p-stories__copy::after { content: ''; display: table; clear: both; }
  .p-stories__item--compact { grid-template-columns: minmax(7rem, 1.45fr) minmax(0, 7.9fr) minmax(13rem, 2.65fr); column-gap: 30px; padding: 28px 0 32px; }
  .p-stories__item--compact .p-stories__body { gap: 13px; }
  .p-stories__item--compact .p-stories__title { max-width: 34ch; }
  .p-stories__item--compact > .p-stories__media { width: 100%; max-width: 16rem; justify-self: end; }
  .p-stories__item--compact > .p-stories__media img { aspect-ratio: 4 / 3; object-fit: cover; }

  @media (max-width: 1040px) {
    .p-featured-news__top { grid-template-columns: 1fr; gap: 28px; }
    .p-featured-news__content .h-h2 { max-width: 22ch; }
    .p-featured-news__continue { max-width: 48rem; margin-top: 28px; }
    .p-stories__media--float { width: 42%; }
    .p-stories__item--compact { grid-template-columns: minmax(6.5rem, 1.3fr) minmax(0, 7fr) minmax(12rem, 3fr); }
  }

  @media (max-width: 760px) {
    .p-news-hero { padding: 20px 0 38px; }
    .p-news-heading { margin-bottom: 26px; }
    .p-featured-news { padding-top: 24px; }
    .p-featured-news__top { gap: 22px; }
    .p-featured-news__continue { margin-top: 24px; padding-top: 22px; }
    .p-stories__item--article,
    .p-stories__item--compact { grid-template-columns: 1fr; gap: 12px; }
    .p-stories__meta { grid-column: 1; }
    .p-stories__body { grid-column: 1; }
    .p-stories__media--float { float: none; width: 100%; margin: 0 0 18px !important; }
    .p-stories__item--compact > .p-stories__media { grid-column: 1; max-width: none; justify-self: stretch; }
    .p-stories__item--compact > .p-stories__media img { aspect-ratio: 16 / 9; }
  }
</style>
