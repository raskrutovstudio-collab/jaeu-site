---
import InnerLayout from '../../layouts/InnerLayout.astro';
import Icon from '../../components/home/Icon.astro';
import { contacts } from '../../data/pages';
import { contactsI18n } from '../../data/pagesI18n';
import { org, routes } from '../../data/home';
import { canonicalUrl, withBase } from '../../data/site';

const asset = (name: string) => withBase(`/assets/jaeu/${name}`);
const canonical = canonicalUrl(routes.contacts);

/*
  Наименование юридического лица, БИН и номер телефона одинаковы на любом языке,
  поэтому ключ ставится только там, где перевод значения подтверждён словарём.
*/
const translated = (key: string) => (key in contactsI18n ? key : undefined);

/* Схема повторяет только видимые на странице подтверждённые контакты. */
const contactSchema = {
  '@type': 'ContactPage',
  '@id': `${canonical}#contactpage`,
  url: canonical,
  mainEntity: {
    '@type': 'Organization',
    name: org.legalName,
    alternateName: org.shortName,
    email: org.email,
    telephone: org.phoneHref,
    address: {
      '@type': 'PostalAddress',
      addressCountry: org.address.country,
      addressRegion: org.address.region,
      addressLocality: org.address.city,
      streetAddress: org.address.street,
      postalCode: org.address.postalCode
    }
  }
};
---

<InnerLayout
  title={contacts.meta.title}
  description={contacts.meta.description}
  ogTitle={contacts.meta.ogTitle}
  path={routes.contacts}
  crumb={contacts.crumb}
  schema={[contactSchema]}
  i18n={contactsI18n}
>
  <section class="p-hero p-hero--split">
    <div class="h-shell">
      <div class="p-hero__inner">
        <div class="p-hero__text">
          <nav class="p-crumbs" aria-label="Хлебные крошки" data-i18n-attrs="aria-label:ui.breadcrumbs">
            <a href={routes.home} data-i18n="ui.home">Главная</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" data-i18n="crumb">{contacts.crumb}</span>
          </nav>
          <p class="h-eyebrow" data-i18n="hero.eyebrow">{contacts.hero.eyebrow}</p>
          <h1 class="h-h1 p-hero__title" data-i18n="hero.h1">{contacts.hero.h1}</h1>
          <p class="h-lead p-hero__lead" data-i18n="hero.lead">{contacts.hero.lead}</p>

          <div class="p-hero__actions">
            <a
              class="h-btn h-btn--primary"
              href={contacts.hero.action.href}
              data-i18n-attrs="href:hero.action.href"
            >
              <span data-i18n="hero.action.label">{contacts.hero.action.label}</span>
              <Icon name="arrow" class="h-btn__arrow" />
            </a>
            <a
              class="h-link"
              href={contacts.hero.call.href}
              aria-label={`Позвонить ${org.phone}`}
              data-i18n-attrs="aria-label:hero.call.aria"
            >
              <span data-i18n="hero.call.label">{contacts.hero.call.label}</span>
              <Icon name="arrow" class="h-link__arrow" />
            </a>
          </div>
        </div>

        <figure class="p-hero__media">
          <img
            src={asset('page-contacts-desk-1160.webp')}
            srcset={`${asset('page-contacts-desk-760.webp')} 760w, ${asset('page-contacts-desk-1160.webp')} 1160w`}
            sizes="(min-width: 1041px) 660px, 100vw"
            width="1160"
            height="497"
            alt={contacts.hero.imageAlt}
            data-i18n-attrs="alt:hero.imageAlt"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Контактные действия открываются в первом экране и не появляются по скроллу. -->
  <section class="h-section h-section--white" aria-labelledby="contacts-actions">
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="contacts-actions" data-i18n="actions.h2">{contacts.actions.h2}</h2>
        <hr class="h-rule" />
      </div>

      <ul class="p-contact">
        {contacts.actions.items.map((item, index) => (
          <li class="p-contact__item">
            <p class="p-contact__term" data-i18n={`actions.items.${index}.term`}>{item.term}</p>

            {'href' in item && item.href ? (
              /* Значение — адрес почты или телефон, поэтому переводится только тема письма. */
              <a
                class="p-contact__value"
                href={item.href}
                aria-label={'aria' in item ? item.aria : undefined}
                data-i18n-attrs={[
                  translated(`actions.items.${index}.href`) ? `href:actions.items.${index}.href` : '',
                  translated(`actions.items.${index}.aria`) ? `aria-label:actions.items.${index}.aria` : ''
                ].filter(Boolean).join(';') || undefined}
              >{item.value}</a>
            ) : (
              <p class="p-contact__value p-contact__value--long" data-i18n={`actions.items.${index}.value`}>{item.value}</p>
            )}

            <p class="p-contact__hint" data-i18n={`actions.items.${index}.hint`}>{item.hint}</p>
          </li>
        ))}
      </ul>

      <p class="p-note" data-i18n="actions.note">{contacts.actions.note}</p>

      <div class="p-facet" aria-hidden="true">
        <svg viewBox="0 0 1160 160" fill="none" stroke="currentColor" stroke-width="1" role="presentation">
          <path d="M328 16H832L860 44V116L832 144H328L300 116V44Z" />
          <path d="M348 42H812L834 64V96L812 118H348L326 96V64Z" />
          <path d="M368 68H792L808 84L792 92H368L352 84Z" />
          <path d="M328 16L348 42M832 16L812 42M832 144L812 118M328 144L348 118" />
          <path d="M300 44L326 64M860 44L834 64M860 116L834 96M300 116L326 96" />
          <path d="M0 84H300M860 84H1160" />
        </svg>
      </div>
    </div>
  </section>

  <section class="h-section h-section--stone" aria-labelledby="contacts-visual" data-reveal>
    <div class="h-shell">
      <div class="p-head p-head--flush">
        <h2 class="h-h2" id="contacts-visual" data-rise="1" data-i18n="visual.title">{contacts.visual.title}</h2>
        <hr class="h-rule" />
        <p class="h-text" data-rise="2" data-i18n="visual.text">{contacts.visual.text}</p>
      </div>
    </div>
  </section>

  <section class="h-section h-section--white" aria-labelledby="contacts-requisites" data-reveal>
    <div class="h-shell">
      <div class="p-head">
        <h2 class="h-h2" id="contacts-requisites" data-rise="1" data-i18n="requisites.h2">{contacts.requisites.h2}</h2>
        <hr class="h-rule" />
      </div>

      <dl class="p-facts" data-rise="2">
        {contacts.requisites.items.map((item, index) => (
          <>
            <dt data-i18n={`requisites.items.${index}.term`}>{item.term}</dt>
            <dd data-i18n={translated(`requisites.items.${index}.value`)}>{item.value}</dd>
          </>
        ))}
      </dl>

      <p class="p-note" data-rise="3">
        <a class="p-lib__ref" href={contacts.requisites.link.href}>
          <span data-i18n="requisites.link.label">{contacts.requisites.link.label}</span>
          <Icon name="arrow" class="p-lib__arrow" />
        </a>
      </p>
    </div>
  </section>

  <section class="p-cta" aria-labelledby="contacts-cta" data-reveal>
    <div class="h-shell">
      <div class="p-cta__inner">
        <div class="p-cta__text-col">
          <h2 class="h-h2 p-cta__title" id="contacts-cta" data-rise="1" data-i18n="cta.h2">{contacts.cta.h2}</h2>
          <p class="p-cta__text" data-rise="2" data-i18n="cta.text">{contacts.cta.text}</p>
        </div>

        <div class="p-cta__actions" data-rise="3">
          <a
            class="h-btn h-btn--light"
            href={contacts.cta.primary.href}
            data-i18n-attrs="href:cta.primary.href"
          >
            <span data-i18n="cta.primary.label">{contacts.cta.primary.label}</span>
            <Icon name="arrow" class="h-btn__arrow" />
          </a>
          <a class="p-cta__link" href={contacts.cta.secondary.href}>
            <span data-i18n="cta.secondary.label">{contacts.cta.secondary.label}</span>
            <Icon name="arrow" class="p-cta__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
